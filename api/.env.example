# Database (libSQL).
#
# Unset, the API uses a local file — which is all local development needs:
#   DATABASE_FILE="invoices.db"
#
# Set these to point at a hosted Turso database instead. Required in any
# deployment: a serverless filesystem is ephemeral, so a local file there does
# not persist between invocations.
#
# Get both with: turso db show <name> --url  /  turso db tokens create <name>
# Never commit real values — .env is gitignored, this file is the template.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

PORT=4000

# Pin the API to one frontend origin in a deployment, e.g.
# CORS_ORIGIN=https://invoice-desk.vercel.app
# Leave unset locally — any origin is allowed.
CORS_ORIGIN=
